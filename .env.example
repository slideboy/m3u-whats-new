# M3U What's New
# Copy this file to .env and fill in your private values.
# Copier ce fichier en .env puis renseigner vos valeurs privées.

# Xtream / provider credentials - required
# Identifiants Xtream / fournisseur - obligatoires
M3U_PROVIDER_URL=
M3U_USERNAME=
M3U_PASSWORD=

# SMTP credentials - optional, only needed for email notifications
# Identifiants SMTP - facultatifs, uniquement pour les notifications email
SMTP_USERNAME=
SMTP_PASSWORD=

# Docker host port / Port hôte Docker
M3U_WHATS_NEW_PORT=36401

# Application/container timezone / Fuseau horaire application/conteneur
TZ=Europe/Paris
